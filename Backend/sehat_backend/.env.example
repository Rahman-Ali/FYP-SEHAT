# ==============================================================================
# SEHAT Backend Environment Configuration Template (.env.example)
# ==============================================================================
# Copy this file to `.env` and supply your actual credentials.
# NEVER commit the `.env` file or secrets to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# Django Core Settings
# ------------------------------------------------------------------------------
SECRET_KEY=django-insecure-change-this-in-production-use-a-strong-random-key
DJANGO_DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,omission-moonshine-cinnamon.ngrok-free.dev

# ------------------------------------------------------------------------------
# PostgreSQL Database (Neon / Remote / Local)
# ------------------------------------------------------------------------------
# NOTE: If Postgres connection fails with Permission denied on Windows, check
# Cloudflare WARP (run `warp-cli disconnect` in terminal) or add a split-tunnel
# exclusion for port 5432.
DATABASE_URL=postgresql://user:password@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# Optional local PostgreSQL fallbacks (used only if DATABASE_URL is not set)
# DB_NAME=sehat
# DB_USER=postgres
# DB_PASSWORD=your_local_postgres_password
# DB_HOST=localhost
# DB_PORT=5432

# ------------------------------------------------------------------------------
# Firebase Admin SDK Credentials (Authentication)
# ------------------------------------------------------------------------------
# Path to service account JSON file, OR supply raw JSON via FIREBASE_SERVICE_ACCOUNT_JSON
FIREBASE_SERVICE_ACCOUNT_KEY=D:\FYP-SEHAT-NEW\Backend\sehat_backend\secrets\firebase-service-account.json
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
FIREBASE_PROJECT_ID=sehat-538ee

# ------------------------------------------------------------------------------
# AI & LLM Provider API Keys
# ------------------------------------------------------------------------------
GOOGLE_API_KEY=your-google-gemini-api-key
GROQ_API_KEY=your-groq-api-key
OPEN_AI_API_KEY=your-openai-api-key

# Auxiliary LLM order: 'groq_first' or 'gemini_first'
AUX_LLM_PROVIDER_ORDER=groq_first

# Hugging Face Token (used for downloading embedding models / HuggingFace Hub)
HUGGINGFACEHUB_API_TOKEN=your-huggingface-token

# ------------------------------------------------------------------------------
# Neo4j Aura Graph Database (Vector Store & Knowledge Base)
# ------------------------------------------------------------------------------
NEO4J_URI=neo4j+s://your-instance-id.databases.neo4j.io
NEO4J_USERNAME=your-neo4j-username
NEO4J_PASSWORD=your-neo4j-password
NEO4J_DATABASE=your-database-name
AURA_INSTANCEID=your-instance-id
AURA_INSTANCENAME=Instance01

# ------------------------------------------------------------------------------
# Ingestion Safety & Management Controls
# ------------------------------------------------------------------------------
# Set to 'true' to allow running `python manage.py ingest_documents` against shared KB
ALLOW_INGEST=true

# Set to 'true' to force re-ingestion even if PDF SHA-256 hash matches Neo4j
FORCE_REINGEST=false
